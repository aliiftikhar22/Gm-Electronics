// Firestore Security Rules for GM Electronics
// Firebase Console → Firestore Database → Rules tab → paste this → Publish

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Products:
    // Anyone can read products so the website can display them.
    // Only a signed-in admin can add/edit/delete.
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders:
    // Anyone can create an order because customers don't need
    // to be logged in.
    // Only a signed-in admin can read, update or delete orders.
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Categories:
    // Anyone can read categories so index.html can display them.
    // Only a signed-in admin can create, edit or delete categories.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
